# Copy to .env and fill in a Gemini API key (https://aistudio.google.com/app/apikey).
# The pipeline runs in mock mode without a key (verifies logic, costs nothing).
GEMINI_API_KEY=

# Model tier for the vision classifier.
GEMINI_MODEL=gemini-2.5-flash

# Hard spend guards (the Gemini API has no native cap on a plain key).
# GAZEGUARD_BUDGET is a hard cumulative cap measured in Indian Rupees (₹150 ≈ $1.75);
# ledger at ~/.gazeguard/ledger.json.
GAZEGUARD_BUDGET=150
# Hard per-run call cap (counts API requests).
GAZEGUARD_MAX_CALLS_PER_RUN=500

# Optional: DoesTheDogDie API key for episode-level content grounding.
# Without it, grounding silently falls back (TMDB/websearch only).
DOES_THE_DOG_DIE_API_KEY=